generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
}

model BrideGallery {
  id           String   @id @default(uuid())
  imageUrl     String

  category     String   @default("INDIAN")

  displayorder Int      @default(0)
  createdAt    DateTime @default(now())
}

model GroomGallery {
  id           String   @id @default(uuid())
  imageUrl     String

  category     String   @default("INDIAN")

  displayorder Int      @default(0)
  createdAt    DateTime @default(now())
}

model HomeSlider {
  id           String   @id @default(uuid())
  title        String?
  imageUrl     String
  displayorder Int
  createdAt    DateTime @default(now())
}

model Set {
  id           String       @id @default(uuid())
  title        String
  mainImage    String
  content      String       @db.Text
  pageUrl      String       @unique
  displayorder Int          @default(0)
  createdAt    DateTime     @default(now())

  gallery      SetGallery[]

  @@index([displayorder])
}

model SetGallery {
  id           String   @id @default(uuid())
  imageUrl     String
  displayorder Int      @default(0)
  createdAt    DateTime @default(now())

  setId        String
  set          Set      @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId], map: "SetGallery_setId_fkey")
  @@index([displayorder])
}

model AddOnService {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String
  displayorder Int
  createdAt    DateTime @default(now())
  pageUrl      String   @unique
}

model Testimonial {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String
  displayorder Int
  createdAt    DateTime @default(now())
}

model Setup {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  mainImage    String
  content      String
  displayOrder Int
  createdAt    DateTime       @default(now())
  pageUrl      String         @unique
  gallery      SetupGallery[]
}

model SetupGallery {
  id           String @id @default(uuid())
  imageUrl     String
  setupId      String
  displayOrder Int    @default(0)
  setup        Setup  @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([setupId], map: "SetupGallery_setupId_fkey")
}

model Props {
  id           String   @id @default(uuid())
  image        String
  title        String
  subTitle     String
  displayOrder Int
  createdAt    DateTime @default(now())
}

model MakeupArtist {
  id           String   @id @default(uuid())
  image        String
  displayOrder Int
  createdAt    DateTime @default(now())
}

model Product {
  id            String     @id @default(uuid())
  name          String
  price         Decimal
  bookingAmount Decimal
  createdAt     DateTime   @default(now())
  slug          String     @unique
  bookings      Booking[]
  slots         Slot[]
  slotLocks     SlotLock[]
}

model Slot {
  id        String        @id @default(uuid())
  productId String
  label     String
  startTime String
  endTime   String
  createdAt DateTime      @default(now())
  bookings  BookingSlot[]
  product   Product       @relation(fields: [productId], references: [id], onDelete: NoAction)
  slotLocks SlotLock[]

  @@index([productId], map: "Slot_productId_fkey")
}

model Booking {
  id                String        @id @default(uuid())
     bookingNumber Int? @unique
  bookingId         String        @unique
  productId         String
  bookingDate       DateTime
  phone             String?
  email             String?
  totalAmount       Decimal?
  paymentStatus     BookingStatus @default(locked)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  lockExpiresAt     DateTime?
  bookingAmount     Decimal?
  gstAmount         Decimal?
  address           String?
  city              String?
  firstName         String?
  lastName          String?
  notes             String?
  postcode          String?
  state             String?
  product           Product       @relation(fields: [productId], references: [id], onDelete: NoAction)
  slots             BookingSlot[]

  @@index([productId, bookingDate])
}

model BookingSlot {
  id        String  @id @default(uuid())
  bookingId String
  slotId    String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction)
  slot      Slot    @relation(fields: [slotId], references: [id], onDelete: NoAction)

  @@unique([bookingId, slotId])
  @@index([slotId], map: "BookingSlot_slotId_fkey")
}

model SlotLock {
  id        String   @id @default(uuid())
  productId String
  slotId    String
  date      DateTime
  locked    Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction)
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: NoAction)

  @@unique([productId, slotId, date])
  @@index([slotId], map: "SlotLock_slotId_fkey")
}

model DateLock {
  id        String   @id @default(uuid())
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
}

enum BookingStatus {
  locked
  paid
  completed
  cancelled
  expired
}

model Gallery {
  id           String   @id @default(cuid())
  imageUrl     String
  displayOrder Int      @default(0)
  imageType    String?  // wide | tall
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique

  content         String   @db.LongText

  metaTitle       String?
  metaDescription String?

  isPublished     Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}